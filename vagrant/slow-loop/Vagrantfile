# Slow-loop test VM for scripts/install.sh / scripts/bootstrap.sh — see
# README.md (this directory) for how to use it and CLAUDE.md's "Installer
# validation (two-tier)" section for why it exists alongside the fast CI loop
# (.github/workflows/install-validation.yml).
#
# This VM is disposable by design: `vagrant destroy -f` between runs, since
# install.sh/bootstrap.sh assume a genuinely fresh node. Nothing here is
# meant to persist.

Vagrant.configure("2") do |config|
  # Debian 12/Ubuntu 24.04 are the other ADR-001 §3.1-supported OSes;
  # trixie64 is used here because it's what caught the ifupdown-vs-netplan
  # bug this loop exists to catch more of — real systemd and real
  # network-interface ownership, which ubuntu-latest in CI can't reproduce
  # (it ships netplan, not ifupdown).
  config.vm.box = "debian/trixie64"
  config.vm.hostname = "homelab-slow-loop"

  # Deliberately disabled: this loop tests the real `curl -fsSL .../install.sh
  # | bash` path an operator actually runs, which clones from GitHub — not a
  # bind-mounted copy of your working tree. Push your branch first (see
  # README.md); a synced folder would let you skip that and test something
  # that isn't actually what a real operator, or the fast CI loop, exercises.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider :libvirt do |lv|
    # Matches ADR-001 §3.1's documented *minimum* control-plane spec (4GB
    # RAM), not a generously-resourced dev box — deliberate, so this loop
    # also catches anything that only breaks on the hardware tier it's
    # actually meant to run on (e.g. a Raspberry Pi 4 with 4GB). Bump locally
    # if you need more headroom while iterating; no need to commit that back.
    lv.memory = 4096
    lv.cpus = 2
  end

  config.vm.provision "shell", inline: <<-SHELL
    apt-get update
    apt-get install -y curl
  SHELL
end
