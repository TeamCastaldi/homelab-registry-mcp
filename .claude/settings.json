{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/credentials.json)",
      "Read(**/.aws/credentials)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)"
    ],
    "ask": [
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git branch -D *)",
      "Bash(git clean -f *)",
      "Bash(git clean -fd *)"
    ],
    "allow": [
      "Bash(bash scripts/validate_skills.sh *)",
      "Bash(bash scripts/check_doc_claims.sh *)",
      "Bash(bash scripts/check_scaffolded_project.sh *)",
      "Bash(bash scripts/test_check_doc_claims.sh *)",
      "Bash(bash scripts/test_check_scaffolded_project.sh *)",
      "Bash(bash .claude/hooks/session-start-hook.sh *)",
      "Bash(bash .claude/hooks/test_session-start-hook.sh *)",
      "Bash(bash .claude/skills/init-project/scripts/check_inherited_docs.sh *)",
      "Bash(bash .claude/skills/init-project/scripts/test_check_inherited_docs.sh *)",
      "Bash(bash .claude/skills/sync-from-template/scripts/test_compare_template.sh *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start-hook.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
