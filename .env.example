# homelab-registry-mcp — environment configuration
#
# Minimum viable config (get started in 5 minutes):
#   TRAEFIK_API_URL, AUTHENTIK_API_URL, AUTHENTIK_TOKEN
#   Everything else has sensible defaults.
#
# Read operations are always on when the upstream is configured.
# Write operations (proposals, normalization) are opt-in — off by default.
# See docs/agentic-design-intent.md for the full design rationale.

# -----------------------------------------------------------------------------
# Persistence
# Both paths should use /data/ to stay on the named Docker volume.
# Using ./data/ (relative) resolves to /app/data/ inside the container —
# a different location that does not persist across rebuilds.
# -----------------------------------------------------------------------------
REGISTRY_DB_PATH=/data/registry.db
REGISTRY_LOG_PATH=/data/events.log
EVENT_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# MCP transport
# streamable-http is recommended for multi-client homelab use.
# Use stdio only for local development or single-client setups.
# -----------------------------------------------------------------------------
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8765

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Traefik integration (read-only)
# Required for discovery, router inspection, and conflict detection.
# -----------------------------------------------------------------------------
TRAEFIK_API_URL=http://<WORKLOAD_NODE_IP>:8080
TRAEFIK_TIMEOUT_SECONDS=10
TRAEFIK_RETRIES=3

# -----------------------------------------------------------------------------
# Authentik integration (read-only)
# Token MUST be a scoped read-only service account. Never use an admin token.
# Required permissions: view on applications, providers, outposts, policies,
# events, users, groups.
# -----------------------------------------------------------------------------
AUTHENTIK_API_URL=https://sso.yourdomain.com/api/v3
AUTHENTIK_TOKEN=
AUTHENTIK_TIMEOUT_SECONDS=10
AUTHENTIK_RETRIES=3

# -----------------------------------------------------------------------------
# Dockhand integration (read-only)
# Enables Dockhand discovery (environments -> stacks -> containers) and the
# dockhand_* query tools. Read-only by design (ADR-013): no update-triggering
# or stack-mutating Dockhand endpoint is ever called from this server, even
# though the API exposes them (POST /api/containers/check-updates, POST
# /api/stacks) — trigger an update from Dockhand's own UI/API instead.
# Distinct from DOCKHAND_WEBHOOK_* further below (ADR-010) — that's an INBOUND
# alert receiver; this is the OUTBOUND read-only query client.
# Token: a Dockhand API token (dh_... prefix), issued via Settings > API
# Tokens in the Dockhand UI. Scope it to a read-only role if available.
# -----------------------------------------------------------------------------
DOCKHAND_API_URL=http://<DOCKHAND_HOST>:<PORT>
DOCKHAND_TOKEN=
DOCKHAND_TIMEOUT_SECONDS=10
DOCKHAND_RETRIES=3

# -----------------------------------------------------------------------------
# documentation-mcp integration (read-only)
# Grounds get_service_documentation in the official, version-specific docs
# documentation-mcp serves. Both URL and token are required to enable the tool.
# -----------------------------------------------------------------------------
DOCS_MCP_URL=http://<DOCS_MCP_HOST>:<PORT>
DOCS_MCP_TOKEN=
DOCS_MCP_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Docker integration (read-only)
# Enables container-level discovery alongside Traefik router discovery.
# Remove or leave blank to disable Docker discovery.
# -----------------------------------------------------------------------------
DOCKER_BASE_URL=unix:///var/run/docker.sock

# -----------------------------------------------------------------------------
# Discovery scheduler
# A source is only enabled when its upstream is configured above.
# Intervals are in seconds.
# -----------------------------------------------------------------------------
DISCOVERY_TRAEFIK_INTERVAL_SECONDS=300
DISCOVERY_DOCKER_INTERVAL_SECONDS=300
DISCOVERY_AUTHENTIK_INTERVAL_SECONDS=900
DISCOVERY_DOCKHAND_INTERVAL_SECONDS=300
DISCOVERY_STALE_AFTER_MISSES=3

# -----------------------------------------------------------------------------
# Reasoning layer — DSPy enrichment (Phase 7, opt-in)
# When enabled, the server uses LLM reasoning to:
#   - resolve fuzzy cross-source matches the deterministic rules miss
#     (ResolveServiceIdentity)
#   - infer display_name/category/auth_mode/notes for new Traefik-only services
#     (InferServiceMetadata)
#   - back the authentik_summarize_events tool (SummarizeAccessAudit)
#   - generate config patches for security proposals (GenerateRemediationPatch)
#   - normalize YAML formatting (NormalizeConfigFile)
# The reasoning layer never writes to infrastructure — it only enriches the
# registry, synthesizes audit summaries, and generates proposed patches.
# Output below the confidence threshold is discarded; the deterministic path
# applies for enrichment, and the proposal is rejected for patch generation.
# DSPY_MODEL is a litellm model id. DSPY_API_KEY falls back to ANTHROPIC_API_KEY.
# DSPY_COMPILED_PATH points at optimized modules saved by a Phase 9 pass.
# -----------------------------------------------------------------------------
DSPY_ENABLED=false
DSPY_MODEL=anthropic/claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=             # used by DSPy/litellm when DSPY_API_KEY is unset
# DSPY_API_KEY=                # override if you want a separate key for this server
DSPY_CONFIDENCE_THRESHOLD=0.7
DSPY_MAX_TOKENS=1024
# DSPY_PATCH_MAX_TOKENS: larger budget for GenerateRemediationPatch, which must
# emit a complete corrected file plus all output fields. Too small truncates the
# response and fails field parsing.
DSPY_PATCH_MAX_TOKENS=4096
# DSPY_COMPILED_PATH=/data/dspy   # dir of optimized modules; loaded at startup if present

# -----------------------------------------------------------------------------
# Notifications (optional)
# Used by the proposal engine to alert when PRs are opened or conflicts
# are verified. Set NOTIFICATION_PROVIDER=none to disable.
# Supported: ntfy | smtp | none
# Future: gotify | pushover | slack | discord
# -----------------------------------------------------------------------------
NOTIFICATION_PROVIDER=none
NOTIFICATION_URL=https://ntfy.yourdomain.com
NOTIFICATION_TOPIC=homelab-registry
# NOTIFICATION_TOKEN=          # Required if your Ntfy topic has auth enabled

# SMTP (Phase 5) — templated HTML email with a PR summary, diff, and
# Approve/Request Changes/View Diff links. Validated in production against
# SMTP2GO (https://www.smtp2go.com/docs/); any STARTTLS-capable relay works.
# All four required when NOTIFICATION_PROVIDER=smtp — falls back to the
# null provider if any are missing.
# NOTIFICATION_SMTP_HOST=mail.smtp2go.com
# NOTIFICATION_SMTP_PORT=587
# NOTIFICATION_SMTP_USERNAME=
# NOTIFICATION_SMTP_PASSWORD=
# NOTIFICATION_SMTP_USE_TLS=true
# NOTIFICATION_FROM_EMAIL=registry-mcp@yourdomain.com
# NOTIFICATION_TO_EMAIL=you@yourdomain.com

# -----------------------------------------------------------------------------
# Git provider (required for write path / Phase 8)
# Used to open pull requests proposing infrastructure remediations.
# Token requires repo read+write scope.
# Supported: gitea | github
# Gitea and Forgejo are API-compatible — use gitea for both.
# For github, GIT_BASE_URL must be the API root (api.github.com for
# public GitHub; a GHES instance's /api/v3 root otherwise) — the provider
# uses this value directly with no path prefix added.
# For gitea, GIT_BASE_URL is your instance's plain host, e.g.
# https://gitea.example.com — the provider appends /api/v1 itself.
# -----------------------------------------------------------------------------
GIT_PROVIDER=github
GIT_BASE_URL=https://api.github.com
GIT_TOKEN=
GIT_REPO=username/homelab
GIT_BASE_BRANCH=main

# -----------------------------------------------------------------------------
# Apply mechanism
# Tells the proposal engine what instructions to put in PR descriptions.
# The MCP server never applies changes itself — it only opens PRs.
# Supported: manual | webhook | ansible
#   manual    — PR description includes manual deploy steps
#   webhook   — PR description notes a webhook triggers deployment on merge
#   ansible   — PR description notes GitHub Actions triggers Ansible on merge
# -----------------------------------------------------------------------------
APPLY_MODE=manual

# -----------------------------------------------------------------------------
# Proposal engine (write path — opt-in)
# PROPOSAL_AUTO_CREATE: when true, the scheduler automatically opens a PR
#   for each detected conflict. When false, use proposal_create() manually.
# PROPOSAL_DRY_RUN: when true, patches are generated and logged but no PRs
#   are opened. Recommended for first deployment of the write path.
# PROPOSAL_STALE_DAYS: open proposals older than this trigger a reminder
#   notification.
# PROPOSAL_CONFIDENCE_THRESHOLD: patches below this score are rejected for
#   manual review rather than committed as PRs.
# PROPOSAL_LABEL: label applied to all PRs opened by this server.
# PROPOSAL_COMPOSE_PATH_TEMPLATE: maps a service to its compose file in the
#   homelab repo. {node} and {service} are substituted at runtime.
# -----------------------------------------------------------------------------
PROPOSAL_AUTO_CREATE=false
PROPOSAL_DRY_RUN=true
PROPOSAL_STALE_DAYS=7
PROPOSAL_CONFIDENCE_THRESHOLD=0.8
PROPOSAL_LABEL=homelab-registry-mcp
PROPOSAL_COMPOSE_PATH_TEMPLATE=nodes/{node}/{service}/compose.yaml

# -----------------------------------------------------------------------------
# Conversational loop (Phase 3 — opt-in, requires the write path above)
# When enabled, the scheduler polls open proposal PRs for new comments and
# asks the reasoning layer to push a revised commit in response — the same
# confidence/YAML gates as initial patch generation apply; low-confidence or
# invalid revisions are never committed. Never runs when system_health_check
# fails at startup (read-only mode).
# PROPOSAL_COMMENT_ALLOWED_USERS: comma-separated GitHub/Gitea usernames whose
#   comments are trusted to trigger a commit. Fails closed — empty (the
#   default) means every comment is ignored, even with polling enabled, since
#   anyone with read access to the PR could otherwise steer a committed change.
# -----------------------------------------------------------------------------
PROPOSAL_COMMENT_POLL_ENABLED=false
PROPOSAL_COMMENT_POLL_INTERVAL_SECONDS=300
PROPOSAL_COMMENT_ALLOWED_USERS=

# -----------------------------------------------------------------------------
# Normalization (opt-in, requires the write path above)
# Scans nodes/*/*/compose.yaml against docs/specs/spec-compose-normal-form.md
# and opens one PR per node with any safe formatting fixes — key order,
# labels/ports/environment shape, a misnamed compose file, ... Every auto-fix
# is proven behavior-preserving (an equivalence check) before it's committed;
# judgment calls (:latest tags, missing restart:, hardcoded secrets, ...) are
# reported, never auto-fixed. Always a separate PR/label from security
# proposals — never bundled. Runs on NORMALIZATION_SCHEDULE and via the
# proposal_normalize tool; never scheduled when the write path isn't
# configured or system_health_check fails at startup (read-only mode).
# Only enable after the security proposal path is proven in production.
# NORMALIZATION_SCHEDULE: `daily`, `weekly`, `monthly`, or a raw seconds value.
# NORMALIZATION_RENAME_MISNAMED: renames docker-compose.yml/.yaml or
#   compose.yml to compose.yaml — the only filename the deploy pipeline can
#   see, so this makes a previously-invisible stack deployable. Opt in
#   separately from the rest of normalization, which is purely cosmetic.
# -----------------------------------------------------------------------------
NORMALIZATION_ENABLED=false
NORMALIZATION_SCHEDULE=weekly
NORMALIZATION_PATH_GLOB=nodes/*/*/compose.yaml
NORMALIZATION_MAX_FILES_PER_PR=25
NORMALIZATION_DRY_RUN=false
NORMALIZATION_RENAME_MISNAMED=false
NORMALIZATION_LABEL=normalization

# -----------------------------------------------------------------------------
# Secrets / git-crypt (Phase C)
# Encrypts .env files in the private homelab repo at rest on GitHub so secrets
# are protected from day one. On by default — set SECRETS_REPO_PATH and one of
# the key options below. Creating that repo and initialising git-crypt in it
# is your own setup step; this project only reads from it.
#
# Key loading priority:
#   1. SECRETS_KEY_PATH (path to the exported key file — recommended for prod)
#   2. SECRETS_GIT_CRYPT_KEY (base64-encoded key bytes — good for Docker secrets)
#
# SECRETS_REPO_PATH: path to the cloned private homelab repo on this node.
# SECRETS_KEY_PATH:  path to the git-crypt key file (chmod 400).
#   Store this key in Vaultwarden. Never commit it to any repository.
# SECRETS_GIT_CRYPT_KEY: base64(key bytes). Fallback when no key file is used.
#   Generate with: base64 /path/to/git-crypt.key | tr -d '\n'
# -----------------------------------------------------------------------------
SECRETS_ENABLED=true
SECRETS_REPO_PATH=/opt/homelab        # Pi default; use an absolute path, e.g. /Users/you/homelab on macOS
# SECRETS_KEY_PATH=/opt/homelab/.git-crypt.key   # Pi; e.g. /Users/you/.config/homelab/git-crypt.key on macOS
# Note: pydantic-settings reads .env as literal strings — $HOME is not expanded here.
# SECRETS_GIT_CRYPT_KEY=

# -----------------------------------------------------------------------------
# Read-only Infisical integration (ADR-016 — opt-in)
# infisical_status reports which secret keys exist at a project/environment/
# path in Infisical — never a value, under any circumstance. Requests
# viewSecretValue=false on every read and independently verifies the value
# was actually masked (secretValueHidden is exactly true AND secretValue is
# a known-safe placeholder); if that check ever fails, the tool call fails
# closed, logs only the affected key's name, and sends an urgent
# NotificationProvider alert recommending that key be rotated immediately.
#
# INFISICAL_CLIENT_ID/INFISICAL_CLIENT_SECRET authenticate to Infisical via
# Universal Auth (see docs/SOPs/SOP-005-Connect-Infisical-Machine-Identity.md
# for creating the Machine Identity). How that credential itself reaches this
# process is a deployment concern this project doesn't solve — it cannot be
# stored in Infisical without being circular.
#
# INFISICAL_PROJECT_ID is the project's ID (not its slug), from Infisical's
# Project Settings page. INFISICAL_SECRET_PATH is the folder within that
# project holding this service's secrets — often not the project root.
# INFISICAL_ALLOW_WRITE is reserved for a future write phase; it does
# nothing yet.
#
# Whole-project visibility (ADR-017 — opt-in, off by default): set
# INFISICAL_RECURSIVE_SCAN=true and INFISICAL_SECRET_PATH=/ (or another
# ancestor folder) to walk every subfolder instead of just one, grouping
# key names by folder under `secrets_by_path` — still never a value. A
# folder the Machine Identity can't read is skipped and reported under
# `inaccessible_paths`, not treated as a failure. This also expands what
# the tool can see across services (every folder's key names, not just
# this one's) — a deliberate scope decision, not just a config toggle; see
# ADR-017. Requires the Machine Identity's Infisical permissions to
# actually cover those other folders, which is an Infisical-side change,
# not something this setting alone grants.
# -----------------------------------------------------------------------------
INFISICAL_ENABLED=false
# INFISICAL_BASE_URL=https://infisical.example.com
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# INFISICAL_PROJECT_ID=
# INFISICAL_ENVIRONMENT=prod
# INFISICAL_SECRET_PATH=/homelab-registry-mcp
INFISICAL_ALLOW_WRITE=false
INFISICAL_RECURSIVE_SCAN=false
INFISICAL_MAX_FOLDERS=50

# -----------------------------------------------------------------------------
# Startup health checks (Phase 2)
# Evaluated once at server startup to decide whether the GitOps write path is
# enabled; the system_health_check tool re-evaluates these checks live for
# diagnostics. When any of these three is missing, this node isn't fully
# provisioned as a control plane and the server starts in read-only mode: the
# GitOps write-path tools that mutate the homelab repo or open PRs
# (proposal_create/cancel, secrets_encrypt/add/rotate) return an error instead
# of running. Restart after fixing to clear it.
# ANSIBLE_CFG_PATH and SSH_KEY_PATH are also what hardware-discover-now uses to
# fact-gather your inventory into the hardware registry (Phase 9b) — point
# ANSIBLE_CFG_PATH at the same ansible.cfg your inventory/deploy workflow uses.
# SECRETS_REPO_PATH above doubles as the "Git repository" check.
# Absolute paths only — same no-expansion caveat as SECRETS_REPO_PATH.
# Unlike SECRETS_REPO_PATH, this path isn't otherwise bind-mounted into the
# container — docker-compose.yml mounts SSH_KEY_PATH at this same path in
# and out specifically so the health check (which runs inside the
# container) can see it. If you're running under Docker, this must be a
# path that exists on the container host, and this same value is what gets
# bind-mounted — there's nothing else to configure, but a systemd unit or
# other non-Compose deployment would need to mount it itself.
# -----------------------------------------------------------------------------
# ANSIBLE_CFG_PATH=/opt/homelab/ansible.cfg
# SSH_KEY_PATH=/home/youruser/.ssh/id_ed25519

# -----------------------------------------------------------------------------
# Ansible inventory sync (ADR-015 — opt-in, requires ANSIBLE_CFG_PATH above)
# ansible-inventory-sync-node/-confirm write one already-registered
# HardwareNode's ansible_host/ansible_groups into a real inventory file via a
# comment-safe ruamel.yaml round-trip, gated by the same math-confirm pattern
# as the delete tools. ANSIBLE_INVENTORY_PATH is deliberately independent of
# ansible.cfg's own `inventory =` setting — set it explicitly to the same
# file so both stay in sync. Absolute paths only — same no-expansion caveat
# as SECRETS_REPO_PATH/ANSIBLE_CFG_PATH.
# -----------------------------------------------------------------------------
# ANSIBLE_INVENTORY_PATH=/opt/homelab/inventory/hosts.yml
# ANSIBLE_INVENTORY_WRITE_CHALLENGE_TTL_MINUTES=5

# -----------------------------------------------------------------------------
# Brownfield adoption (Phase 7 — opt-in, requires GIT_*, SECRETS_REPO_PATH, and
# SSH_KEY_PATH above)
# proposal_adopt_service SSHes into the HardwareNode a discovered-but-unmanaged
# service is linked to (see hardware-link-service), reads the live container's
# env and its original docker-compose.yml, and asks the reasoning layer to
# sanitize hardcoded secrets into ${VAR} interpolations. Nothing is committed
# until proposal_adopt_service_finalize is called with the operator's choice
# to keep the live secret values or rotate them (always a local random value,
# never generated by the reasoning layer).
# SSH_DEFAULT_USER: user for the ad-hoc SSH connection used to inspect a live
#   container — reuses SSH_KEY_PATH, the same key Ansible uses.
# ADOPTION_DRAFT_TTL_MINUTES: how long a drafted adoption may sit awaiting the
#   operator's keep/rotate decision before it expires.
# -----------------------------------------------------------------------------
ADOPTION_ENABLED=false
SSH_DEFAULT_USER=root
ADOPTION_DRAFT_TTL_MINUTES=60

# -----------------------------------------------------------------------------
# Conversational deploy (docs/plans/conversational-deploy.md — opt-in)
# Phase 1 (ADR-018): service-intake-repo shallow-clones a caller-supplied
# https:// URL and deterministically extracts base image, ports, env vars,
# volumes, and dependencies from its Dockerfile/compose file/README — no LLM
# in the parsing itself. Phase 2 (ADR-019): service-deploy-generate-compose
# re-runs intake, then asks the reasoning layer to draft a compose.yaml
# against this repo's own canonical rules (always) plus
# SERVICE_DEPLOY_CONVENTIONS_PATH from the homelab repo (best-effort).
#
# The flag lands with Phase 1 rather than later: intake alone grants an MCP
# client outbound network access to an arbitrary host, which is the
# capability worth gating — not the (not-yet-built) Git write. Read-only,
# single-call, nothing is drafted or committed by either tool yet.
#
# SERVICE_DEPLOY_CONFIDENCE_THRESHOLD: same gate value the proposal layer
#   uses; a below-threshold inference is discarded (inference: null), never
#   guessed.
# SERVICE_DEPLOY_CLONE_TIMEOUT_SECONDS / _MAX_REPO_MB: bound one intake
#   clone against a hung fetch or an oversized/hostile repo.
# SERVICE_DEPLOY_CONVENTIONS_PATH: homelab-repo compose spec read via GIT_*
#   as supplementary context only — this repo's own rules always win on
#   conflict, since the homelab copy is known to drift.
# -----------------------------------------------------------------------------
SERVICE_DEPLOY_ENABLED=false
SERVICE_DEPLOY_CONFIDENCE_THRESHOLD=0.8
SERVICE_DEPLOY_CLONE_TIMEOUT_SECONDS=60
SERVICE_DEPLOY_MAX_REPO_MB=100
SERVICE_DEPLOY_CONVENTIONS_PATH=docs/spec/compose.yaml

# -----------------------------------------------------------------------------
# Dockhand webhook (ADR-010 — opt-in, requires GIT_* above)
# Dockhand POSTs here when it detects a newer upstream image, or finds CVEs in
# an image it scanned. The alert becomes a staged image_update /
# vulnerability_scan proposal through the same engine every other write path
# uses — a PR a human merges. It never touches the registry or a container.
#
# Fail-closed: DOCKHAND_WEBHOOK_ENABLED=true with no DOCKHAND_WEBHOOK_SECRET
# leaves the route unregistered entirely rather than open. Dockhand does not
# sign its webhook bodies, so the secret is presented as a bearer token —
# configure it as `Authorization: Bearer <secret>` (or X-Dockhand-Token) on
# Dockhand's generic webhook notifier.
#
# Dockhand's built-in Webhooks channel borrows Apprise's URL scheme names but
# does not run the real Apprise engine, so it cannot deliver the header this
# secret needs no matter how the URL is written. Reaching this endpoint
# requires a real Apprise engine in between — run caronc/apprise-api as a
# sidecar, store the header-carrying URL there:
#   json://<registry-host>:8765/webhooks/dockhand?+X-Dockhand-Token=<secret>
# and point Dockhand at apprise://<apprise-api-host>:8000/<key> instead.
# See docs/SOPs/SOP-002-Connect-Dockhand-Webhook.md for the full procedure.
#
# Note on payload shapes: the generic-JSON channel sends a flat
# {title, message, ...} body whose image references are often digests
# (image=sha256:...). A digest names no version a compose file can carry, so
# those alerts are acknowledged and ignored rather than turned into a guessed
# tag bump. Use DOCKHAND_WEBHOOK_LOG_RAW_PAYLOAD below to see what your own
# Dockhand build actually sends before assuming either way.
#
# DOCKHAND_WEBHOOK_MAX_BODY_BYTES: cap on an accepted request body.
# DOCKHAND_WEBHOOK_VULNERABILITY_MIN_SEVERITY: low | medium | high | critical.
#   A CVE with no fixed version upstream is recorded as a rejected proposal and
#   notified — there is no file change to propose, so no PR is opened.
# -----------------------------------------------------------------------------
DOCKHAND_WEBHOOK_ENABLED=false
DOCKHAND_WEBHOOK_PATH=/webhooks/dockhand
# DOCKHAND_WEBHOOK_SECRET=
DOCKHAND_WEBHOOK_MAX_BODY_BYTES=65536
DOCKHAND_WEBHOOK_VULNERABILITY_ENABLED=true
DOCKHAND_WEBHOOK_VULNERABILITY_MIN_SEVERITY=high
# Logs each authorized delivery body verbatim, for working out what your
# Dockhand build sends. Turn it back off afterwards: the body is logged as one
# string, so field-name secret redaction does not reach inside it.
DOCKHAND_WEBHOOK_LOG_RAW_PAYLOAD=false
